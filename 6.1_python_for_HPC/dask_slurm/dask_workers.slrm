#!/bin/bash
#SBATCH --job-name="dask-workers"
#SBATCH --output="dask-workers.%j.%N.out"
#SBATCH --partition=compute
#SBATCH --reservation=si26cpu
#SBATCH --qos=normal-eot
#SBATCH --account=sdp173
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=128
#SBATCH --export=ALL
#SBATCH --mem=242G
#SBATCH --time=00:30:00

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export PYHPC_WORKER_SCRIPT="${SCRIPT_DIR}/launch_worker.sh"
export DASK_WORKER_THREADS="${SLURM_CPUS_PER_TASK}"
export DASK_WORKER_MEMORY="240GB"
SIF_PATH="${PYHPC_SIF_PATH:-/expanse/lustre/projects/sds166/zonca/dask-numba-si26.sif}"

if [[ ! -f "$SIF_PATH" ]]; then
    echo "ERROR: Singularity image not found: $SIF_PATH"
    echo "       Set PYHPC_SIF_PATH to the image you want to use."
    exit 1
fi

module load singularitypro

srun --exact --ntasks="${SLURM_NNODES}" --ntasks-per-node=1 --unbuffered \
    singularity exec \
    --bind /expanse \
    "$SIF_PATH" \
    bash -c 'exec "$PYHPC_WORKER_SCRIPT"'
