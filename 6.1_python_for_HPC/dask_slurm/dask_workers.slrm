#!/bin/bash
#SBATCH --job-name="dask-workers"
#SBATCH --output="dask-workers.%j.%N.out"
#SBATCH --partition=compute
#SBATCH --reservation=si26cpu
#SBATCH --qos=normal-eot
#SBATCH --account=sdp173
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=128
#SBATCH --export=ALL
#SBATCH --mem=242G
#SBATCH --time=00:30:00

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export PYHPC_WORKER_SCRIPT="${SCRIPT_DIR}/launch_worker.sh"
export DASK_WORKER_THREADS="${SLURM_CPUS_PER_TASK}"
export DASK_WORKER_MEMORY="240GB"
export PYHPC_MINIFORGE_DIR="/expanse/lustre/projects/sdp173/zonca/miniforge3"
export PYHPC_CONDA_ACTIVATE="${PYHPC_MINIFORGE_DIR}/envs/pythonhpc/bin/activate"

srun --exact --ntasks="${SLURM_NNODES}" --ntasks-per-node=1 --unbuffered \
    bash -c 'source "$PYHPC_CONDA_ACTIVATE" && exec "$PYHPC_WORKER_SCRIPT"'
