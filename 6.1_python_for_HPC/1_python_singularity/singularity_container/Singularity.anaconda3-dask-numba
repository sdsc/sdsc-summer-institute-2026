Bootstrap: oras
From: ghcr.io/mkandes/naked-singularity:ubuntu-22.04
# From: ghcr.io/mkandes/naked-singularity:miniconda3-py39-4.11.0-ubuntu-20.04


%labels

    APPLICATION_NAME anaconda3dasknumba

    AUTHOR_NAME Andrea Zonca
    AUTHOR_EMAIL zonca@sdsc.edu

    LAST_UPDATED 20260729

%setup

%environment

    export MAMBA_ROOT_PREFIX="/opt/micromamba/"
    export ENV_NAME=si26

    export PATH="${MAMBA_ROOT_PREFIX}/envs/${ENV_NAME}/bin:${PATH}"

%post -c /bin/bash

    set -e

    # Set system locale
    export LC_ALL='C'

    # Set debian frontend interface
    export DEBIAN_FRONTEND='noninteractive'

    apt-get -y install graphviz

    # Cleanup
    apt-get -y autoremove --purge
    apt-get -y clean

    export MAMBA_ROOT_PREFIX="/opt/micromamba/"
    export MAMBA="${MAMBA_ROOT_PREFIX}/bin/micromamba"
    export ENV_NAME=si26

    mkdir -p ${MAMBA_ROOT_PREFIX}
    cd ${MAMBA_ROOT_PREFIX}
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba

    source ${HOME}/.bashrc

    $MAMBA create -n $ENV_NAME -c conda-forge --yes \
    'python==3.12' \
    'jupyterlab' \
    'dask' \
    'dask-labextension' \
    'distributed' \
    'numba' \
    'python-graphviz' \
    'pandas' \
    'matplotlib' \
    'graphviz' \
    'ipycytoscape' \
    'psutil' \
    'h5py' \
    'Pillow' \
    'ipywidgets' \
    'scikit-image' \
    'scikit-learn' \
    'jupyter-ai' \
    'langchain-google-genai' \
    'astropy' \
    'black' \
    'pytables' \
    'xarray' \
    'netcdf4' \
    'jupyter-resource-usage' \
    'jupyter-server-proxy' && \
    "${MAMBA}" clean --all -f -y

    # Update database for mlocate
    updatedb

%files

%runscript

%test

    python --version
    python -c "import numpy, numba, dask, distributed, pandas, psutil, graphviz"
